# You'll get this from BotFather when you create a new Telegram bot (message @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# You'll get this from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# You'll get this from your Neon dashboard (Connect / Connection Details section)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require